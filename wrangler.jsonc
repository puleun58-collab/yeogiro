{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yeogiro",
  "main": "./worker.js",
  "compatibility_date": "2026-08-21",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
