{
  "name": "yeogiro",
  "version": "1.0.0",
  "description": "일정, 예약 서류와 이동 경로를 관리하는 여기로 여행 플래너",
  "scripts": {
    "build": "node -e \"const f=require('fs');f.rmSync('dist',{recursive:true,force:true});f.mkdirSync('dist',{recursive:true});for(const file of ['index.html','offline.html','manifest.webmanifest','sw.js'])f.copyFileSync(file,'dist/'+file);f.mkdirSync('dist/assets',{recursive:true});f.cpSync('assets/icons','dist/assets/icons',{recursive:true})\"",
    "check": "node --check worker.js && node --check sw.js",
    "deploy": "npm run build && wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puleun58-collab/yeogiro.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/puleun58-collab/yeogiro/issues"
  },
  "homepage": "https://github.com/puleun58-collab/yeogiro#readme",
  "devDependencies": {
    "wrangler": "^4.125.0"
  }
}
